# bulkhaul-manage-web 生产 Nginx（envsubst 模板）：托管前端 dist + /api 反代后端
# 官方 nginx 镜像 entrypoint 会对 /etc/nginx/templates/*.template 跑 envsubst，
# 用容器环境变量 BACKEND_UPSTREAM 替换 ${BACKEND_UPSTREAM}（compose 注入 backend；本地可 localhost）。
# 注意：用 resolver + 变量 upstream 做运行时解析——Docker/WSL2 下 upstream 块会在 nginx 启动时
# 用系统 DNS 解析服务名（易超时失败）；改为 resolver 指向 Docker 内嵌 DNS(127.0.0.11) + 变量，
# nginx 运行时按需解析（localhost 走 /etc/hosts，无需 DNS）。
server {
    listen 80;
    server_name _;

    # 后端 upstream（compose 注入服务名 backend；本地可 localhost）+ Docker 内嵌 DNS 运行时解析
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_UPSTREAM}:8081;

    # gzip（前端产物 + API JSON）
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # 静态资源（Vue CLI 产物，hash 文件名可长缓存）
    root /usr/share/nginx/html;
    index index.html;

    # 带 hash 的静态资源长缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # /api 反代后端（前端用相对 /api，无 CORS）
    location /api/ {
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SPA 路由（hash 模式，仍兜底 index.html）
    location / {
        try_files $uri $uri/ /index.html;
    }
}
